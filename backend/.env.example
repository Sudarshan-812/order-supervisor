# Order Supervisor backend config. Copy to .env and fill in real values.

# PostgreSQL connection string. Any Postgres 13+ works. The POC is developed
# against Neon (https://neon.tech). Use a DIRECT connection string (host without
# "-pooler"); the pooled endpoint runs PgBouncer in transaction mode, which
# breaks asyncpg prepared statements. Keep the ?sslmode=require suffix for Neon.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# Temporal dev server (temporal server start-dev). Not needed if you run
# scripts.dev_stack, which starts an in-process Temporal.
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# LLM. Leave GEMINI_API_KEY empty for deterministic mock mode (no network calls,
# used by tests and offline demos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Lifecycle guard rails.
MAX_WORKFLOW_AGE_HOURS=168        # workflow completes once it is this old
DEFAULT_WAKE_INTERVAL_MINUTES=60  # fallback scheduled wake cadence

API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
