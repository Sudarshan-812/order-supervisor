# ---------------------------------------------------------------------------
# Order Supervisor - backend configuration
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Any Postgres 13+ works; the POC is developed
# against Neon (https://neon.tech - free, no project cap).
#
# Use Neon's DIRECT connection string (host WITHOUT "-pooler"). The pooled
# endpoint runs PgBouncer in transaction mode, which breaks asyncpg's prepared
# statements unless you also set statement_cache_size=0.
#
# Neon requires TLS - keep the ?sslmode=require suffix. asyncpg (>=0.25) parses
# it from the DSN directly.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
DB_SCHEMA=public

# Tip: `neon link` (Neon CLI) writes DATABASE_URL / DATABASE_URL_UNPOOLED into
# the repo-root .env.local. Copy the *_UNPOOLED value here (strip
# &channel_binding=require - asyncpg doesn't parse it).

# Temporal dev server (run: `temporal server start-dev`)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# LLM (Google Gemini). Leave GEMINI_API_KEY empty to run in deterministic
# "mock" mode (no network calls) - useful for local dev and tests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Workflow lifecycle guard rails
MAX_WORKFLOW_AGE_HOURS=168        # hard cap: workflow completes after this age
DEFAULT_WAKE_INTERVAL_MINUTES=60  # fallback scheduled wake-up cadence

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
