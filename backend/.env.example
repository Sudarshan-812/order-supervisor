# ---------------------------------------------------------------------------
# Order Supervisor - backend configuration
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL / Supabase connection string.
# All tables live in a dedicated schema (see DB_SCHEMA) so they never collide
# with anything else in the same database.
DATABASE_URL=postgresql://user:password@host:5432/postgres
DB_SCHEMA=order_supervisor

# Temporal dev server (run: `temporal server start-dev`)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# LLM (Google Gemini). Leave GEMINI_API_KEY empty to run in deterministic
# "mock" mode (no network calls) - useful for local dev and tests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Workflow lifecycle guard rails
MAX_WORKFLOW_AGE_HOURS=168        # hard cap: workflow completes after this age
DEFAULT_WAKE_INTERVAL_MINUTES=60  # fallback scheduled wake-up cadence

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
